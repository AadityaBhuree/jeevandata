FROM node:20-alpine AS base
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# ─── Dependencies ─────────────────────────────
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/backend/package.json ./apps/backend/
COPY packages/*/package.json ./packages/
RUN pnpm install --frozen-lockfile --prod

# ─── Build ────────────────────────────────────
FROM base AS builder
COPY . .
RUN pnpm install --frozen-lockfile
# Shared packages must be built first: ts-jest/tsc resolve @jeevandata/*
# through node_modules -> dist, which does not exist on a fresh clone.
RUN pnpm --filter '@jeevandata/shared-*' build
# Prisma client must be generated before compiling (TS2307/TS2694 otherwise).
RUN pnpm --filter @jeevandata/backend prisma:generate
RUN pnpm --filter @jeevandata/backend build

# ─── Production ───────────────────────────────
FROM base AS runner
ENV NODE_ENV=production

# node_modules comes from the BUILDER (full install incl. devDeps + generated
# @prisma/client). The --prod deps stage's install is a different pnpm virtual
# store (no generated client, different peer-dep hash), so copying from it broke
# runtime prisma resolution (@prisma/client did not initialize yet).
# TODO(slim): switch deps stage to `pnpm deploy` to shrink the image again.
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/backend/node_modules ./apps/backend/node_modules
# Run as a non-root user (k8s manifests enforce runAsNonRoot + runAsUser 1000).
# node:20-alpine already ships a 'node' user with uid/gid 1000, so reuse it
# instead of addgroup/adduser (gid 1000 is already in use in the base image).
COPY --from=builder --chown=node:node /app/apps/backend/dist ./apps/backend/dist
COPY --from=builder --chown=node:node /app/apps/backend/package.json ./apps/backend/
COPY --from=builder --chown=node:node /app/packages ./packages

USER node

EXPOSE 4000

CMD ["node", "apps/backend/dist/main.js"]
