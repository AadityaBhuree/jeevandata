# ─────────────────────────────────────────────
# Jeevandata — Environment Configuration
# ─────────────────────────────────────────────
# Two env files (both git-ignored, never commit either):
#   .env          — local development (localhost URLs, NODE_ENV=development)
#   .env.docker   — inside Docker (container hostnames, NODE_ENV=production)
# Copy this file to .env and fill in values; for Docker deployments copy it
# to .env.docker and switch the URL hosts to container names
# (jeevandata-postgres:5432, jeevandata-redis:6379, jeevandata-qdrant:6333,
#  jeevandata-minio:9000, jeevandata-whisper:9001).
# ─────────────────────────────────────────────

# Application
NODE_ENV=development
APP_NAME=Jeevandata
APP_PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://jeevandata:jeevandata_secret@localhost:5432/jeevandata?schema=public

# Redis (Session cache + BullMQ queue) — compose publishes host 6380
REDIS_URL=redis://default:redis_secret@localhost:6380

# Qdrant (Vector search)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Cloudflare R2 (Object storage)
R2_ENDPOINT=http://localhost:9000
R2_REGION=auto
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_PUBLIC_BUCKET=jeevandata-media
R2_AUDIO_PREFIX=audio
R2_FACE_PREFIX=faces

# Google Gemini (AI Chat — primary)
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Anthropic (Claude — fallback)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI (Whisper)
OPENAI_API_KEY=sk-xxxxxxxx
WHISPER_API_URL=http://localhost:9001/inference

# JWT
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_REFRESH_SECRET=change-this-to-a-different-random-secret
JWT_EXPIRATION=24h

# Session
SESSION_INACTIVITY_TIMEOUT_MS=600000
SESSION_AUTO_CLOSE_MS=600000

# Security
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# API Documentation (Swagger/OpenAPI at /api/docs)
# Swagger is enabled in non-production automatically; set to true to force-enable in production.
SWAGGER_ENABLED=false

# Face Recognition
FACE_MATCH_THRESHOLD=0.82
FACE_EMBEDDING_DIM=512
LIVENESS_THRESHOLD=0.7

# Audio
AUDIO_AUTO_DELETE_DAYS=30
AUDIO_FORMAT=opus
AUDIO_SAMPLE_RATE=48000

# Archival
ARCHIVAL_COLD_AFTER_DAYS=90

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
