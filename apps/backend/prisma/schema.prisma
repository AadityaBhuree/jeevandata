generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Extensions (uuid-ossp, pgcrypto, vector) are created by the
  // postgres-init.sql entrypoint script on first boot. They are not
  // declared here because Prisma passes extension names literally and
  // `uuid-ossp`/`vector` cannot be listed reliably across Prisma versions.
}

enum SessionStatus {
  INITIATED
  FACE_MATCHED
  CONTEXT_LOADED
  INTAKE_IN_PROGRESS
  TRANSCRIBING
  BRIEF_GENERATED
  SYNCED
  COMPLETED
  FAILED
  TIMED_OUT
}

enum UserRole {
  RECEPTIONIST
  DOCTOR
  ADMIN
  SYSTEM
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ─── Clinic (multi-tenancy) ────────────────────────────────────
model Clinic {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(200)
  code      String   @unique @db.VarChar(20)
  address   String?  @db.VarChar(500)
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(255)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    ClinicUser[]
  patients Patient[]
  sessions IntakeSession[]
  apiKeys  ApiKey[]

  @@map("clinics")
}

// ─── API Key (external integrations) ────────────────────────────
model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(100)
  keyHash    String    @unique @db.Char(64) // SHA-256 of the raw key
  prefix     String    @unique @db.VarChar(24) // e.g. jk_a1B2c3 for identification
  clinicId   String?   @db.Uuid
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([clinicId])
  @@map("api_keys")
}

// ─── Patient ───────────────────────────────────────────────────
model Patient {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @db.VarChar(200)
  dob            DateTime        @db.Date
  mobile         String          @unique @db.VarChar(15)
  aadhaarRef     String?         @db.Char(64) // SHA-256 hash only
  consentGranted Boolean         @default(false)
  clinicId       String?         @db.Uuid
  isDeleted      Boolean         @default(false)
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  faceEmbeddings  FaceEmbedding[]
  intakeSessions  IntakeSession[]
  intakeRecords   IntakeRecord[]
  clinic          Clinic?         @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([clinicId])
  @@index([isDeleted])
  @@map("patients")
}

// ─── Face Embedding ────────────────────────────────────────────
model FaceEmbedding {
  id         String   @id @default(uuid()) @db.Uuid
  patientId  String   @db.Uuid
  capturedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("face_embeddings")
}

// ─── Intake Session ────────────────────────────────────────────
model IntakeSession {
  id        String        @id @default(uuid()) @db.Uuid
  patientId String?       @db.Uuid
  clinicId  String?       @db.Uuid
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  status    SessionStatus @default(INITIATED)
  deviceId  String        @db.VarChar(100)
  metadata  Json          @default("{}")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  patient     Patient?              @relation(fields: [patientId], references: [id], onDelete: SetNull)
  clinic      Clinic?               @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  intakeRecords IntakeRecord[]
  transcripts   SessionTranscript[]

  @@index([patientId])
  @@index([clinicId])
  @@index([status])
  @@index([startedAt])
  @@map("intake_sessions")
}

// ─── Session Transcript ────────────────────────────────────────
model SessionTranscript {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @db.Uuid
  speaker     String   @db.VarChar(20) // 'patient', 'ai', 'system'
  text        String   @db.Text
  timestampMs BigInt
  createdAt   DateTime @default(now())

  session IntakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([timestampMs])
  @@map("session_transcripts")
}

// ─── Intake Record (Clinical Brief) ────────────────────────────
model IntakeRecord {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @db.Uuid
  patientId   String   @db.Uuid
  brief       Json     // ClinicalBrief
  intakeData  Json     // IntakeData
  generatedAt DateTime @default(now())

  session IntakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  patient Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([patientId])
  @@index([generatedAt])
  @@map("intake_records")
}

// ─── Audit Log ─────────────────────────────────────────────────
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  action       String   @db.VarChar(200)
  actorId      String   @db.VarChar(100)
  actorRole    UserRole
  resourceType String   @db.VarChar(100)
  resourceId   String   @db.VarChar(100)
  details      Json     @default("{}")
  ipAddress    String   @db.VarChar(45)
  timestamp    DateTime @default(now())

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ─── Clinic User ───────────────────────────────────────────────
model ClinicUser {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  name         String   @db.VarChar(200)
  role         UserRole @default(RECEPTIONIST)
  clinicId     String?  @db.Uuid
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  clinic        Clinic?           @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([clinicId])
  @@map("clinic_users")
}

// ─── Refresh Token (JWT rotation / revocation) ────────────────
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  // SHA-256 hash of the refresh token (never store the raw token)
  tokenHash String    @unique @db.VarChar(64)
  userId    String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user ClinicUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─── PMS Patient Cache (for offline-first) ─────────────────────
model PmsPatientCache {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @unique @db.Uuid
  data        Json     // Full patient data from PMS
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("pms_patient_cache")
}
