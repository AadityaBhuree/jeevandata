{
  "name": "jeevandata",
  "version": "1.0.0",
  "private": true,
  "description": "Jeevandata — AI-powered smart clinic intake system",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "verify:browser": "node scripts/browser-journey.mjs",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @jeevandata/backend prisma generate",
    "db:push": "pnpm --filter @jeevandata/backend prisma db push",
    "db:migrate": "pnpm --filter @jeevandata/backend prisma migrate dev",
    "db:seed": "pnpm --filter @jeevandata/backend prisma db seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose -f docker-compose.yml -f docker-compose.app.yml down",
    "prepare": "husky || node -e \"process.exit(0)\"",
    "postinstall": "husky || node -e \"process.exit(0)\"",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d postgres redis qdrant minio minio-init",
    "docker:dev:all": "docker compose -f docker-compose.yml -f docker-compose.app.yml -f docker-compose.dev.yml up -d"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
